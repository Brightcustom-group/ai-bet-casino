# Copy to .env.local (never commit real values). Placeholders only.

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key (or legacy anon key). Safe for browsers; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Canonical site origin used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only ---
# Set to "enabled" ONLY in production. Anything else serves noindex + robots "Disallow: /".
SITE_INDEXING=disabled

# Planned (not used yet) — keep server-side only, never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=           # background jobs/webhooks only, never in browser code
# SPORTS_DATA_API_BASE_URL=      # licensed sports-data provider (sandbox first)
# SPORTS_DATA_API_KEY=
# SPORTS_DATA_WEBHOOK_SECRET=    # verifies signed odds/result webhooks
# INTERNAL_WEBHOOK_SECRET=       # signs article-published events
